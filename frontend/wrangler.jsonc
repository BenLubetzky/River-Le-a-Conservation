// Cloudflare Workers config for the website: the static export in out/ (from `npm run build`),
// plus worker/index.ts, which forwards /api/... to the backend on Railway.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guardioes-do-leca",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // /guide serves out/guide.html, and so on.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only /api/... runs the Worker; everything else is a static file, served directly.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "BACKEND_URL": "https://api-production-9c06f.up.railway.app"
  }
}
